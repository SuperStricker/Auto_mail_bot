# Gmail Credentials (2FA + 16-digit Google App Password required)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password

# Telegram Bot Credentials (from @BotFather & @userinfobot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_numeric_telegram_chat_id

# LinkedIn Session Cookie (Optional: helps fetch private/auth-walled posts)
LINKEDIN_LI_AT=

# Cloudflare MailTracker & Bridge
TRACKER_BASE_URL=https://your-worker.your-subdomain.workers.dev
TRACKER_SECRET=

# Candidate Profile & Signature (Override per user without editing Python code)
USER_NAME=Your Full Name
USER_PHONE=+91 XXXXXXXXXX
USER_LINKEDIN=https://www.linkedin.com/in/your-profile
USER_LOCATION=City, Country (Available for Relocation / Remote)
CV_INDIA_FILENAME=Domestic_CV.pdf
CV_GLOBAL_FILENAME=International_CV.pdf
